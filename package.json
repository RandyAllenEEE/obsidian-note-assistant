{
    "name": "obsidian-note-assistant",
    "version": "1.0.0",
    "description": "A note content assistant plugin for Obsidian, providing heading numbering and formula numbering features.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check": "npm run typecheck && npm test && npm run build"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "headings",
        "formulas",
        "numbering"
    ],
    "author": "Randy Allen <https://github.com/RandyAllenEEE>",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^24.13.3",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.28.1",
        "obsidian": "^1.5.0",
        "tslib": "2.4.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    }
}
